module Decoder (
	input logic [1:0] Op,
	input logic [5:0] Funct,
	input logic [3:0] Rd,
	
	output logic [1:0] FlagsW,
	output logic PCS,
	output logic RegW,
	output logic MemW
	output logic MemtoReg,
	output logic ALUSrc,
	output logic [1:0] ImmSrc,
	output logic [1:0] RegSrc,
	output logic [1:0] ALUControl
);

	logic Branch;
	logic ALUOp;

	/* PC Logic */
	PC_Logic pc_logic_uut (
		.Rd(Rd),
		.Branch(Branch),
		.RegW(RegW),
		.PCS(PCS)
	);
	
	/* Main Decoder */
	MainDecoder maindecder_uut (
		.Op(Op),
		.Funct5(Funct5),
		.Funct0(Funct0),
		.Branch(Branch),
		.RegW(RegW),
		.MemW(MemW),
		.MemtoReg(MemtoReg),
		.ALUSrc(ALUSrc),
		.ImmSrc(ImmSrc),
		.RegSrc(RegSrc),
		.ALUOp(ALUOp)
	);
	
	/* ALU Decoder */
	ALU_Decoder alu_decoder_uut (
		.cmd(Funct[4:1]),
		.ALUOp(ALUOp),
		.ALUControl(ALUControl),
		.FlagsW(FlagsW)
	);

endmodule