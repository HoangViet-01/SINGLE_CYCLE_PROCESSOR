module tb_top();

  logic clk;
  logic reset;
  logic [31:0] WriteData, DataAdr;
  logic MemWrite;

  // Khởi tạo module top (CPU + imem + dmem)
  top dut (
    .clk (clk),
    .reset (reset),
    .WriteData (WriteData),
    .DataAdr (DataAdr),
    .MemWrite (MemWrite)
  );

  // Reset ban đầu
  initial begin
    reset <= 1;
    #22;
    reset <= 0;
  end

  // Tạo xung clock chu kỳ 10ns
  always begin
    clk <= 1; #5;
    clk <= 0; #5;
  end

  // Kiểm tra kết quả ghi vào Data Memory tại sườn âm clock
  always @(negedge clk) begin
    if (MemWrite) begin
      if (DataAdr === 32'd4 && WriteData === 32'd2) begin
        $display("Simulation succeeded! Mem[4] = %0d", WriteData);
        $stop;
      end else begin
        $display("Simulation failed! Unexpected write: Mem[%0d] = %0d", DataAdr, WriteData);
        $stop;
      end
    end
  end

  // Giới hạn thời gian mô phỏng để tránh treo vòng lặp B 0x00
  initial begin
    #400;
    $display("Simulation timed out!");
    $stop;
  end

endmodule