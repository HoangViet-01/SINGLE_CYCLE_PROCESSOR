transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Register_File.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/PC_reg.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/MUX_21.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/ADD.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/ALU.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Extend_32bit.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Data_Mem.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/top_datapath.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/MainDecoder.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/ALU_Decoder.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/PC_Logic.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Decoder.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Condition_Check.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Conditional_Logic.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/top_controller.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/top.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Shift.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/cpu.sv}
vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/Instr_Mem.sv}

vlog -sv -work work +incdir+D:/file\ TKS_VXL/Single_processor_ARM {D:/file TKS_VXL/Single_processor_ARM/tb_debug.sv}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L fiftyfivenm_ver -L rtl_work -L work -voptargs="+acc"  tb_debug

add wave *
view structure
view signals
run -all
