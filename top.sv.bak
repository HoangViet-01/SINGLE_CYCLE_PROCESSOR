module top # (
	parameter int WIDTH = 32,
	parameter int ADDR_WIDTH = 32,
	parameter int DATA_WIDTH = 32,
	parameter int SIZE = 512
) (
	input logic clk,
	input logic rst
);

	logic [WIDTH - 1:0] Instr;
	logic [3:0] ALUFlags;
	
	logic PCSrc;
	logic MemtoReg;
	logic MemWrite;
	logic [3:0] ALUControl;
	logic ALUSrc;
	logic [1:0] ImmSrc;
	logic RegWrite;
	logic [1:0] RegSrc;

endmodule