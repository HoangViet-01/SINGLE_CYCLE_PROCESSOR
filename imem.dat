E3A00000  // 0x00: MOV   R0, #0        (R0 = 0, làm địa chỉ nền cho STR/LDR)
E3A01005  // 0x04: MOV   R1, #5        (R1 = 5 = 0b0101)
E3A02003  // 0x08: MOV   R2, #3        (R2 = 3 = 0b0011)
E0813002  // 0x0C: ADD   R3, R1, R2    (ADD  không cờ: R3 = 8, S=0)
E0914002  // 0x10: ADDS  R4, R1, R2    (ADDS có cờ:    R4 = 8, S=1 -> Z=0)
E0415002  // 0x14: SUB   R5, R1, R2    (SUB  không cờ: R5 = 2, S=0)
E0516001  // 0x18: SUBS  R6, R1, R1    (SUBS có cờ:    R6 = 0, S=1 -> Z=1)
E0017002  // 0x1C: AND   R7, R1, R2    (AND  không cờ: R7 = 1, S=0)
E0118002  // 0x20: ANDS  R8, R1, R2    (ANDS có cờ:    R8 = 1, S=1 -> Z=0)
E1819002  // 0x24: ORR   R9, R1, R2    (ORR  không cờ: R9 = 7, S=0)
E191A002  // 0x28: ORRS  R10, R1, R2   (ORRS có cờ:    R10 = 7, S=1 -> Z=0)
E1110002  // 0x2C: TST   R1, R2        (TST  có cờ:    5 & 3 = 1 != 0 -> Z=0)
E1310001  // 0x30: TEQ   R1, R1        (TEQ  có cờ:    5 ^ 5 = 0 == 0 -> Z=1)
E1510002  // 0x34: CMP   R1, R2        (CMP  có cờ:    5 - 3 = 2 != 0 -> Z=0)
0A000001  // 0x38: BEQ   0x44          (BEQ khi Z=0 -> KHÔNG nhảy, đi tiếp 0x3C)
1A000000  // 0x3C: BNE   0x44          (BNE khi Z=0 -> NHẢY tới 0x44; imm24 = 0)
E3A0B0EE  // 0x40: MOV   R11, #0xEE    (Lệnh bẫy - bị bỏ qua vì BNE nhảy tới 0x44)
E1510001  // 0x44: CMP   R1, R1        (CMP  có cờ:    5 - 5 = 0 == 0 -> Z=1)
1A000001  // 0x48: BNE   0x54          (BNE khi Z=1 -> KHÔNG nhảy, đi tiếp 0x4C)
0A000000  // 0x4C: BEQ   0x54          (BEQ khi Z=1 -> NHẢY tới 0x54; imm24 = 0)
E3A0C0DD  // 0x50: MOV   R12, #0xDD    (Lệnh bẫy - bị bỏ qua vì BEQ nhảy tới 0x54)
E5803004  // 0x54: STR   R3, [R0, #4]  (STR: ghi R3 = 8 vào Mem[4])
E590B004  // 0x58: LDR   R11, [R0, #4] (LDR: đọc Mem[4] = 8 vào R11)
EAFFFFE7  // 0x5C: B     0x00          (B không điều kiện: nhảy về 0x00; imm24 = -24 = 0xFFFFE8)