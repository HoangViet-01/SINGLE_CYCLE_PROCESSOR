module Extend_32bit (
	input logic [23:0] Instr,
	input logic [1:0] ImmSrc,
	output logic [31:0] ExtImm
);

//	logic [31:0] unRot_8bit; // Thuoc truong hop Instr = 0, 8bit cuoi chua dc dich.
//	logic [4:0] rot; // 4 bit dich. 
// ExtImm = (unRot_8bit >> 2*rot) | (unRot_8bit << (32 - 2*rot))

	always_comb begin
		ExtImm = '0;
		case (ImmSrc) 
		
			// 8-bit : Cac lenh lien qua den DP.
			2'b00 : ExtImm = {24'b0, Instr[7:0]};
			
			//12-bit : Cac lenh lien quan den Memory.
			2'b01 : ExtImm = {20'b0, Instr[11:0]};
			
			// 24-bit : Cac lenh lien quan den Branch.
			2'b10 : ExtImm = {{6{Instr[23]}}, Instr[23:0], 2'b00}; // Mo rong co dau va dich trai 2 bit.
		endcase
	end

endmodule